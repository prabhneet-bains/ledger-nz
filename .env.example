# === App ===
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://YOUR_PAGES_DOMAIN.pages.dev

# Local SQLite is used when SUPABASE_URL is empty.
# Set ALLOW_DEV_AUTH=true only on a private development machine.
DATABASE_URL=sqlite:///./ledger.db
ALLOW_DEV_AUTH=false

# Optional override for the internal-transfer detector.
# TRANSFER_REGEX=
# Own-account names that appear on transfers between the transactions and savings accounts.
OWN_ACCOUNT_LABELS=savings,transactions
TRANSFER_WINDOW_DAYS=3

# === Supabase (production) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# === Auth0 (production login) ===
# Leave blank to keep Supabase email login. The client id is public (SPA app).
# Do not put an Auth0 client secret here.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://ledger-nz-api
AUTH0_CLIENT_ID=your-spa-client-id

# === Google Drive (service account JSON path) ===
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-shared-folder-id

# === Receipt OCR ===
# Groq vision (same approach as Expense Tracker). Leave blank to skip cloud OCR.
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Local Ollama over Tailscale. Leave blank unless that workstation is running.
OCR_TAILSCALE_HOST=
OCR_MODEL=qwen3.6:27b
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_TIMEOUT_SECONDS=180
WOL_ENABLED=true
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
WOL_BROADCAST=255.255.255.255
WOL_PORT=9
WOL_WAIT_SECONDS=90
