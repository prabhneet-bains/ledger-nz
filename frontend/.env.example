NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# No trailing slash. A trailing slash becomes //dashboard and can break requests.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local practice button. Leave unset on Cloudflare Pages.
NEXT_PUBLIC_DEV_AUTH=false

# Auth0 SPA. Leave blank to keep the Supabase email form.
# Client id is public. Never put an Auth0 client secret in the frontend.
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://ledger-nz-api
